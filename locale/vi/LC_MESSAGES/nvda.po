msgstr "Proxy WinHTTP:"

msgid "Check complete."
msgstr "Đã hoàn tất kiểm tra."

msgid "Network check complete."
msgstr "Đã hoàn tất kiểm tra mạng."

msgid "DNS assistant is off or no DNS provider is selected. Open add-on settings to enable it."
msgstr "Trợ lý DNS đang tắt hoặc chưa chọn nhà cung cấp DNS. Mở phần cài đặt add-on để bật lại."

msgid "Measuring DNS response. Please wait..."
msgstr "Đang đo phản hồi DNS. Vui lòng chờ..."

msgid "Measuring DNS response."
msgstr "Đang đo phản hồi DNS."

msgid "DNS MEASUREMENT RESULTS"
msgstr "KẾT QUẢ ĐO DNS"

msgid "No DNS providers responded."
msgstr "Không có DNS nào phản hồi."

msgid "No public DNS providers responded."
msgstr "Không có DNS công cộng nào phản hồi."

msgid "Recommendation: {} ({} and {})."
msgstr "Đề xuất: {} ({} và {})."

msgid "You still need to choose a connection and confirm before DNS is changed."
msgstr "Bạn vẫn cần chọn kết nối và xác nhận trước khi DNS được thay đổi."

msgid "The DNS assistant was turned off while measuring."
msgstr "Trợ lý DNS đã được tắt trong khi đang đo."

msgid "DNS recommendation is ready."
msgstr "Đã có đề xuất DNS."

msgid "Found a recommended DNS."
msgstr "Đã tìm được DNS đề xuất."

msgid "Finding active connections..."
msgstr "Đang tìm kết nối đang hoạt động..."

msgid "Could not find an active network connection."
msgstr "Không tìm thấy kết nối mạng đang hoạt động."

msgid "Choose the connection that will receive the IPv4 DNS configuration. Do not choose a VPN unless you are sure."
msgstr "Chọn kết nối sẽ nhận cấu hình DNS IPv4. Không chọn VPN nếu bạn không chắc chắn."

msgid "Choose network connection"
msgstr "Chọn kết nối mạng"

msgid "The DNS assistant is turned off in the add-on settings."
msgstr "Trợ lý DNS đang bị tắt trong phần cài đặt add-on."

msgid " Quad9 provides security filtering and may block some domain names."
msgstr " Quad9 có bộ lọc bảo mật và có thể chặn một số tên miền."

msgid "IPv4 DNS for connection '{adapter}' will be replaced with {provider}: {primary} and {secondary}. Current DNS: {currentDns}. This does not guarantee faster internet.{providerNote} Windows will request administrator permission. Continue?"
msgstr "DNS IPv4 của kết nối '{adapter}' sẽ được thay bằng {provider}: {primary} và {secondary}. DNS hiện tại: {currentDns}. Điều này không bảo đảm Internet nhanh hơn.{providerNote} Windows sẽ yêu cầu quyền quản trị. Tiếp tục?"

msgid "The manually configured IPv4 DNS for connection '{adapter}' will be replaced with automatic DNS from DHCP. Current DNS: {currentDns}. Windows will request administrator permission. Continue?"
msgstr "DNS IPv4 thủ công của kết nối '{adapter}' sẽ bị thay bằng DNS tự động từ DHCP. DNS hiện tại: {currentDns}. Windows sẽ yêu cầu quyền quản trị. Tiếp tục?"

msgid "Cancelled."
msgstr "Đã hủy."

msgid "Task information is invalid; the task was not run."
msgstr "Thông tin tác vụ không hợp lệ; tác vụ chưa được chạy."

msgid "Windows will request administrator permission. Waiting for completion..."
msgstr "Windows sẽ yêu cầu quyền quản trị. Đang chờ hoàn tất..."

msgid "Windows will request administrator permission. Running the task."
msgstr "Windows sẽ yêu cầu quyền quản trị. Đang chạy tác vụ."

msgid "Could not verify the task result: {}."
msgstr "Không thể kiểm tra kết quả tác vụ: {}."

msgid "Task complete."
msgstr "Đã hoàn tất tác vụ."

msgid "Task did not complete."
msgstr "Tác vụ không hoàn tất."
