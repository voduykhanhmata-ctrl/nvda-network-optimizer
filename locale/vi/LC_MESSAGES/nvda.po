msgstr "&Tối ưu và chẩn đoán mạng..."

msgid "Open Network Optimizer and Diagnostics"
msgstr "Mở Tối ưu và chẩn đoán mạng"

msgid "Open Network Optimizer and Diagnostics settings"
msgstr "Mở phần cài đặt Tối ưu và chẩn đoán mạng"

