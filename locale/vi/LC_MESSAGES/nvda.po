msgstr "Tác vụ này đang bị ẩn trong phần cài đặt add-on."

msgid "Checking the connection. Please wait..."
msgstr "Đang kiểm tra kết nối. Vui lòng chờ..."

msgid "Checking the network."
msgstr "Đang kiểm tra mạng."

msgid "QUICK CHECK REPORT"
msgstr "BÁO CÁO KIỂM TRA NHANH"

msgid "Active IPv4 connections:"
msgstr "Kết nối IPv4 đang hoạt động:"

msgid "Active connection: Could not determine."
msgstr "Kết nối đang hoạt động: Không xác định được."

msgid "DNS response (this is DNS server responsiveness only, not overall internet speed):"
msgstr "Phản hồi DNS (chỉ là độ phản hồi của máy chủ DNS, không phải toàn bộ tốc độ Internet):"

msgid "not responding (0/3)"
msgstr "không phản hồi (0/3)"

msgid "{} ms"
msgstr "{} ms"

